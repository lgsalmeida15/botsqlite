SQLITE_PATH=data/helptoa.sqlite
TOA_ORIGIN=https://clarosa.etadirect.com
# Login automático: fluxo completo (#username/#password) e restore (só senha).
# Use aspas se a senha tiver # ou caracteres especiais. Ex.: TOA_PASS="senha#@#"
TOA_USER=
TOA_PASS=
# Proxy corporativo para alcançar o TOA. Sem esta chave o Chromium e o
# WebSocket saem direto e o firewall engole a conexão (net::ERR_TIMED_OUT).
# Vale tanto para a navegação (Playwright) quanto para o WS em python/toa.py.
# Formato: http://<host-do-proxy>:<porta>
TOA_PROXY=
# 1 = Chromium sem janela (produção). 0 = janela visível (debug local).
TOA_HEADLESS=1
# Tempo máximo (ms) para carregar páginas do TOA. Padrão 60000 (60s).
# Aumente em servidores mais lentos, ex.: TOA_NAV_TIMEOUT_MS=120000
TOA_NAV_TIMEOUT_MS=60000
# Token da API PHP /api/v1/classifications (header X-Bot-Token).
BOT_API_TOKEN=
# Script criar_apoio (HTTP interno). Não commitar a chave.
APOIO_API_URL=
APOIO_STATUS_URL=
APOIO_API_KEY=
# Script criar_infra_rede (POST). GET e chave iguais ao apoio.
INFRA_REDE_API_URL=
# Script remanejamento_rota (POST). GET e chave iguais ao apoio.
REMANEJAMENTO_API_URL=
# Script criar_acesso_hub (POST no webhook, corpo JSON {"text": "..."}). Não commitar.
WEBHOOK_ACESSO_HUB=
# Banco: `sqlite` (padrão, arquivo em SQLITE_PATH) ou `mysql` (servidor abaixo).
# O default é sempre `sqlite`: o MySQL só liga com a linha explícita abaixo.
DB_BACKEND=sqlite
#DB_BACKEND=mysql
# MySQL 8.0.19+ — obrigatórias apenas com DB_BACKEND=mysql (mesmos nomes no painel PHP).
# Sem valor, o boot para com a lista exata das chaves que faltam.
IP_MYSQL=
PORTA_MYSQL=3306
USUARIO_MYSQL=
SENHA_MYSQL=
DATABASE_MYSQL=
