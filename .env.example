SQLITE_PATH=data/helptoa.sqlite
TOA_ORIGIN=https://clarosa.etadirect.com
# Login automático: fluxo completo (#username/#password) e restore (só senha).
# Use aspas se a senha tiver # ou caracteres especiais. Ex.: TOA_PASS="senha#@#"
TOA_USER=
TOA_PASS=
# 1 = Chromium sem janela (produção). 0 = janela visível (debug local).
TOA_HEADLESS=1
# Tempo máximo (ms) para carregar páginas do TOA. Padrão 60000 (60s).
# Aumente em servidores mais lentos, ex.: TOA_NAV_TIMEOUT_MS=120000
TOA_NAV_TIMEOUT_MS=60000
# Token da API PHP /api/v1/classifications (header X-Bot-Token).
BOT_API_TOKEN=
# Script criar_apoio (HTTP interno). Não commitar a chave.
APOIO_API_URL=
APOIO_STATUS_URL=
APOIO_API_KEY=
# Script criar_infra_rede (POST). GET e chave iguais ao apoio.
INFRA_REDE_API_URL=
